# ─── Supabase (leave blank to run in local demo mode with a JSON file store) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin ───
ADMIN_PASSWORD=change-me-please
# Random 32+ char string used to sign admin session cookies.
ADMIN_SESSION_SECRET=

# ─── Public URL of the guest submission site (used for the QR code) ───
# e.g. https://wish.example.com  — defaults to the current host if blank.
NEXT_PUBLIC_GUEST_URL=

# ─── Deployment role: all | guest | display ───
# guest   → only the submission site + submit API
# display → only the tree display, admin dashboard and their APIs
APP_ROLE=all
